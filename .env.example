# LLM Provider — choose ONE block below

# --- Option A: OpenAI ---
# MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-...

# --- Option B: Groq (fast & free tier) ---
# MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# --- Option C: Local Ollama ---
# MODEL=ollama/llama3
# (no key needed)

# Active selection (edit this):
MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────
# Execution mode: "docker" or "local"
# "docker" requires Docker Engine running
# "local"  uses subprocess (less isolated)
CODE_EXEC_MODE=local
# ─────────────────────────────────────────────
